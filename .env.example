# Conexão PostgreSQL (em produção, prefira a URL "pooled" do provedor)
DATABASE_URL=

# Credenciais do painel administrativo
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo para assinar a sessão do admin (mínimo 32 caracteres aleatórios)
SESSION_SECRET=

# Use "development" localmente e "production" na Vercel
NODE_ENV=production

# Porta do servidor local (opcional)
PORT=3000
