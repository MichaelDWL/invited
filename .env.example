# Conexão PostgreSQL. Na Vercel, use a URL do "Transaction pooler" do Supabase (porta 6543)
DATABASE_URL=

# Credenciais do painel administrativo
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo para assinar a sessão do admin (mínimo 32 caracteres aleatórios)
SESSION_SECRET=

# "development" localmente e "production" na Vercel
NODE_ENV=

# Porta do servidor local (opcional, padrão 3000)
PORT=
