{
  "name": "convite-aniversario",
  "version": "1.0.0",
  "private": true,
  "description": "Convite digital de aniversário com confirmação de presença e painel administrativo.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "db:init": "node --env-file=.env src/database/init.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3"
  }
}
